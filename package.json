{
  "name": "dsh-board",
  "version": "0.37.0",
  "description": "Ticket-first agent board for DeepSeek Harness: humans plan and approve, agents claim tickets and work in isolated Git worktrees, every run is audited and review-gated.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs",
    "install-profile": "bash scripts/install-profile.sh",
    "test": "node --test test/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ui": "node scripts/ui-e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  },
  "author": "dsh-board contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoomerPH/dsh-board.git"
  },
  "bugs": {
    "url": "https://github.com/HoomerPH/dsh-board/issues"
  },
  "homepage": "https://github.com/HoomerPH/dsh-board#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "agent",
    "kanban",
    "tickets",
    "worktree",
    "ai-agents",
    "code-review"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/"
  ]
}
